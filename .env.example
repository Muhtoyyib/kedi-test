# Canonical origin of the site, e.g. https://[domain]. Required for production
# deploys (assert:prod fails without it); used for canonical links and sitemap.
VITE_SITE_URL=

# Apps Script web app endpoint — orders, forms and referral codes post here
# (public; protected by validation, honeypot and rate limits). When unset,
# order logging and forms are disabled and the WhatsApp fallback is shown.
VITE_APPS_SCRIPT_URL=

# Analytics IDs — a missing ID disables that tracker silently (docs/architecture.md §6).
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# Catalog fetch — build time only, never exposed to the client.
#   fixture  (default) read scripts/fixtures/catalog.fixture.json — local dev & PR previews
#   live     pull from the Apps Script web app — production deploys
CATALOG_SOURCE=fixture

# Apps Script web app URL and its read token (must match the script property).
APPS_SCRIPT_URL=
CATALOG_READ_TOKEN=
